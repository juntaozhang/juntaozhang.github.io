<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>fastjson-upgrade-verify</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fastjson-1284</artifactId>
    <name>fastjson-1.2.84</name>

    <properties>
        <fastjson.version>1.2.84</fastjson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>${fastjson.version}</version>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>fastjson-1247</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>fastjson-1268</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- test-jar 不传递 compile/test 依赖，运行时需要的第三方库要显式声明 -->
        <dependency>
            <groupId>net.sf.json-lib</groupId>
            <artifactId>json-lib</artifactId>
            <version>2.4</version>
            <classifier>jdk15</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 扫描 test-jar 依赖里的测试类 -->
                    <dependenciesToScan>
                        <dependency>com.example:fastjson-1247</dependency>
                        <dependency>com.example:fastjson-1268</dependency>
                    </dependenciesToScan>
                    <!-- fastjson 历史测试类命名不规则，扩展默认匹配模式 -->
                    <includes>
                        <include>**/*Test*.class</include>
                        <include>**/Issue*.class</include>
                    </includes>
                    <!-- 把版本显式传给测试，避免依赖 JSON.VERSION 字段不准 -->
                    <systemPropertyVariables>
                        <fastjson.version>${fastjson.version}</fastjson.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
